# Copy to .env (never commit it) or export these in your shell.
# Generate a key:  python -c "import secrets; print(secrets.token_urlsafe(24))"
MEDALERT_API_KEY=
# Demo time controls (fast-forward, reset). Never enable with real patients.
MEDALERT_DEMO_MODE=1
DATABASE_URL=sqlite:///./medialert.db
# DATABASE_URL=postgresql+psycopg://user:pass@host/medialert   # pilot (add psycopg to requirements)
MEDALERT_TIMEZONE=Africa/Dar_es_Salaam
MEDALERT_GRACE_MINUTES=120
MEDALERT_ACK_EARLY_MINUTES=60
MEDALERT_RISK_THRESHOLD=0.6
MEDALERT_REFILL_WARNING_DAYS=3
MEDALERT_MONITOR_INTERVAL=60
